{
  "name": "laundry-os",
  "version": "0.1.0",
  "private": true,
  "description": "Laundry management SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@laundry/api",
    "dev:web": "npm run dev --workspace=@laundry/web",
    "dev:wag": "npm --workspace apps/whatsapp-gateway run dev",
    "build": "npm run build --workspaces"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1"
  }
}
